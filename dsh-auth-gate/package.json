{
  "name": "dsh-auth-gate",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "Startup authorization gate for DSH Desktop: verifies the authorization at boot, hosts the login flow, and stores the session token for MCP servers and knowledge-base consumers.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anywhere-labs/deepseek-harness-desktop.git",
    "directory": "dsh-auth-gate"
  },
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "verify": "node scripts/verify-client-bundle.mjs && node scripts/verify-auth-gate.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./constants": {
      "default": "./lib/constants.js"
    },
    "./session": {
      "default": "./lib/session.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "external": [
        "react"
      ],
      "platform": "web"
    }
  }
}
